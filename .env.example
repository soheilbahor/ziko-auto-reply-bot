# Installer writes this format to /etc/ziko-assistant/ziko.env. Never commit real secrets.
BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_IDS=123456789
# Telegram user ID of the account that connects Telegram Business.
# Keep this separate from ADMIN_IDS. Without it, Business auto-reply stays disabled.
BUSINESS_OWNER_ID=123456789
DATABASE_PATH=/var/lib/ziko-assistant/ziko.sqlite3
LOG_LEVEL=INFO
