# Installer writes this format to /etc/ziko-assistant/ziko.env. Never commit real secrets.
BOT_TOKEN=000000000:REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_IDS=123456789
# Telegram user ID of the account that connects Telegram Business.
# Keep this separate from ADMIN_IDS. Without it, Business auto-reply stays disabled.
BUSINESS_OWNER_ID=123456789
DATABASE_PATH=/var/lib/ziko-assistant/ziko.sqlite3
LOG_LEVEL=INFO

# Child bot tokens are encrypted with a Fernet key. Recommended location (fresh installs):
#   ZIKO_TENANT_KEY_FILE=/etc/ziko-assistant/tenant-token.key   (root:ziko 0640)
# It is then EXCLUDED from platform backups: keep an offline copy, or restored child
# bots cannot be decrypted. Without this setting the key is kept in the data directory
# (/var/lib/ziko-assistant/tenant-token.key) and included in every backup.
# Move an existing key with: sudo systemctl stop ziko && sudo ziko security move-key
# ZIKO_TENANT_KEY_FILE=/etc/ziko-assistant/tenant-token.key

# Platform capacity controls for child bots.
ZIKO_TENANT_MAX_TOTAL=50
ZIKO_TENANT_PER_USER_PER_HOUR=3
ZIKO_TENANT_MAX_CONCURRENT_POLLERS=10
# Optional JPEG fallback for child bot profile photos when the master photo cannot be read.
# ZIKO_TENANT_PROFILE_PHOTO=/var/lib/ziko-assistant/profile.jpg

# Days to retain inbound event IDs for duplicate-update protection (1..365).
ZIKO_EVENT_RETENTION_DAYS=30

# Logging (see docs/LOGGING.md). Defaults are fine for most servers.
# ZIKO_LOG_DIR=/var/lib/ziko-assistant/logs
# ZIKO_LOG_MAX_BYTES=5242880
# ZIKO_LOG_BACKUP_COUNT=5
# ZIKO_LOG_DEDUP_SECONDS=60
# ZIKO_LOG_ALERTS=1
# ZIKO_LOG_ALERT_INTERVAL_SECONDS=300

# Proactive Telegram alerts to ADMIN_IDS about child bots (see app/platform_alerts.py).
# By default only admin-actionable problems alert: polling stopped/silent, token rejected.
# Off by default. Turn on with:
# ZIKO_PLATFORM_ALERTS=1
# ZIKO_ALERT_STATES=crashed,token             # add: warning,blocked (owner-side problems)
# ZIKO_ALERT_INTERVAL_SECONDS=60              # 15..3600
# ZIKO_ALERT_CONFIRM_CHECKS=2                 # consecutive bad checks before alerting
# ZIKO_ALERT_COOLDOWN_SECONDS=3600            # per bot, before re-alerting
# ZIKO_ALERT_MAX_PER_HOUR=6                   # global cap; excess is summarised later

# /platform and alerts share one overview snapshot refreshed in the background.
# ZIKO_OVERVIEW_REFRESH_SECONDS=30            # 5..600; the 🔄 button always rescans
