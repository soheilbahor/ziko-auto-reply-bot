[Unit]
Description=ZIKO Telegram Business Assistant
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=ziko
Group=ziko
WorkingDirectory=/opt/ziko-assistant
EnvironmentFile=/etc/ziko-assistant/ziko.env
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/ziko-assistant/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ziko-assistant
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
